const { 
    Client, 
    GatewayIntentBits, 
    ActionRowBuilder, 
    StringSelectMenuBuilder, 
    ButtonBuilder, 
    ButtonStyle, 
    ChannelType, 
    PermissionFlagsBits 
} = require('discord.js');

const client = new Client({ intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages] });

const TICKET_CATEGORY_ID = 'YOUR_CATEGORY_ID_HERE'; // Replace with your Category ID

client.once('ready', () => {
    console.log(`🤖 Bot is online as ${client.user.tag}!`);
});

// Command to deploy the initial ticket dropdown message
client.on('messageCreate', async (message) => {
    if (message.content === '!setup-tickets' && message.member.permissions.has(PermissionFlagsBits.Administrator)) {
        
        const row = new ActionRowBuilder()
            .addComponents(
                new StringSelectMenuBuilder()
                    .setCustomId('ticket_select')
                    .setPlaceholder('Select a ticket category...')
                    .addOptions([
                        { label: 'Partnership', description: 'Discuss collaborations and partnerships', value: 'partnership' },
                        { label: 'Report', description: 'Report a user or an issue', value: 'report' },
                        { label: 'Apply', description: 'Apply for staff or open positions', value: 'apply' },
                        { label: 'Claim Perks', description: 'Claim your donor or event perks', value: 'claim_perks' },
                    ]),
            );

        await message.channel.send({
            content: '📩 **Need assistance?** Select the appropriate category below to open a ticket.',
            components: [row]
        });
    }
});

// Interaction Handler
client.on('interactionCreate', async (interaction) => {
    if (!interaction.isStringSelectMenu() && !interaction.isButton()) return;

    // 1. Handling the Dropdown Menu Selection
    if (interaction.isStringSelectMenu() && interaction.customId === 'ticket_select') {
        const selectedValue = interaction.values[0];
        const user = interaction.user;

        await interaction.deferReply({ ephemeral: true });

        // Create the private ticket channel
        const ticketChannel = await interaction.guild.channels.create({
            name: `🎫-${selectedValue}-${user.username}`,
            type: ChannelType.GuildText,
            parent: TICKET_CATEGORY_ID,
            permissionOverwrites: [
                { id: interaction.guild.id, deny: [PermissionFlagsBits.ViewChannel] }, // Hide from everyone
                { id: user.id, allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages] }, // Show to user
            ],
        });

        // Define automatic responses based on selection
        let welcomeMessage = `Welcome ${user}! A staff member will be with you shortly.`;
        let componentsRow = null;

        switch (selectedValue) {
            case 'partnership':
                welcomeMessage = `🤝 **Partnership Ticket Opened!**\nWelcome ${user}. Please select an option below or state your inquiry.`;
                // Add the two custom buttons for Partnership
                componentsRow = new ActionRowBuilder().addComponents(
                    new ButtonBuilder().setCustomId('partner_request').setLabel('Partnership Request').setStyle(ButtonStyle.Primary),
                    new ButtonBuilder().setCustomId('server_adv').setLabel('Our Server Advertisement').setStyle(ButtonStyle.Secondary)
                );
                break;
            case 'report':
                welcomeMessage = `🚨 **Report Ticket Opened!**\nWelcome ${user}. Please provide the user's ID and clear evidence (screenshots/videos) of the incident.`;
                break;
            case 'apply':
                welcomeMessage = `📝 **Application Ticket Opened!**\nWelcome ${user}. Please state the position you are applying for.`;
                break;
            case 'claim_perks':
                welcomeMessage = `🎁 **Perks Ticket Opened!**\nWelcome ${user}. Please provide proof of your boost, or event/gwys win so we can grant your perks.`;
                break;
        }

        // Send the automatic response into the newly created ticket channel
        const msgOptions = { content: welcomeMessage };
        if (componentsRow) msgOptions.components = [componentsRow];

        await ticketChannel.send(msgOptions);

        // Acknowledge to the user that the ticket was created
        await interaction.editReply({ content: `Ticket created successfully! Check out your channel here: ${ticketChannel}` });
    }

    // 2. Handling the Partnership Buttons
    if (interaction.isButton()) {
        if (interaction.customId === 'partner_request') {
            await interaction.reply({
                content: `📝 **Partnership Request Info:**\nPlease drop your server link and member count. Our Partnership Manager will review it shortly!`,
            });
        }
        
        if (interaction.customId === 'server_adv') {
            await interaction.reply({
                content: `📢 **Our Server Advertisement:**\nHere is our official advertisement template. Please copy the text below and post it in your server's partner channel!\n\n\`\`\`\n[https://discord.com/channels/1497426357628698655/1511052450113786006/1512519270905675938]\n\`\`\``,
            });
        }
    }
});

client.login('YOUR_BOT_TOKEN_HERE'); // Replace with your actual Bot Token
